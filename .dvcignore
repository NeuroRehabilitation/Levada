# Add patterns of files dvc should ignore, which could improve
# the performance. Learn more at
# https://dvc.org/doc/user-guide/dvcignore
# ──────────────────────────────────────────────
# UNITY + DVC IGNORE RULES
# ──────────────────────────────────────────────

# Unity generated cache, logs, and build files
[Ll]ibrary/
[Tt]emp/
[Oo]bj/
[Bb]uild/
[Bb]uilds/
[Ll]ogs/
[Uu]ser[Ss]ettings/
[Mm]emoryCaptures/
[Rr]ecordings/

# Common temp or system files
.DS_Store
Thumbs.db
*.tmp
*.bak
*.log
*.old
*~

# Unity auto-generated or meta project files
*.csproj
*.sln
*.pidb
*.user
*.pdb
*.mdb
*.suo
*.svd
*.booproj
*.unityproj

# IDE/editor configs
.vscode/
.idea/
*.iml

# Build outputs and packages
*.apk
*.aab
*.unitypackage
*.zip

# Auto-generated Unity metadata you don't need in DVC cache
*.meta

# Crashlytics or debug reports
sysinfo.txt
crashlytics-build.properties

# Exclude subdirectories you don’t want DVC to hash
Assets/Plugins/Editor/JetBrains*
Assets/StreamingAssets/aa/
